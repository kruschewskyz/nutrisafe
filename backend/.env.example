# Copie para .env e preencha. NUNCA faça commit do .env.
NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose up -d sobe um banco local com estes dados)
DATABASE_URL=postgresql://nutrisafe:nutrisafe@localhost:5432/nutrisafe?schema=public

# Gere cada segredo com:  openssl rand -base64 64
# Devem ser DIFERENTES entre si e entre ambientes (dev/prod).
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
TOKEN_HASH_PEPPER=troque-por-outro-segredo-aleatorio-com-pelo-menos-32-caracteres

# Access token curto (segundos) e refresh token opaco (dias)
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Origens do frontend permitidas no CORS (separadas por vírgula). Em produção: só https.
CORS_ORIGIN=http://localhost:5173
# URL pública do frontend (usada no link de redefinição de senha)
APP_URL=http://localhost:5173

# Número de proxies reversos na frente da API (Railway/Render = 1). 0 em dev.
TRUST_PROXY=0

# strict (padrão) exige frontend e API no mesmo "site" (ou proxy /api via Vercel rewrite).
COOKIE_SAMESITE=strict

LOG_LEVEL=info
